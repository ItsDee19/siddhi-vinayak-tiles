# Security headers for Netlify / Cloudflare Pages. Vercel uses vercel.json.
# Only application/ld+json data blocks are inline; executable scripts are files.
# Local fonts and static PDF page images need no external origins, workers,
# frame embeds, eval or blob permissions. React motion styles remain inline.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; frame-src 'none'; connect-src 'self'; worker-src 'none'; child-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests

# Fingerprinted Vite bundle files live directly under /assets.
/assets/:file
  Cache-Control: public, max-age=31536000, immutable

# Catalogue documents and rendered pages keep stable paths, so revalidate.
/assets/catalogue/*
  Cache-Control: public, max-age=0, must-revalidate
/catalogues/*
  Cache-Control: public, max-age=0, must-revalidate
/og-image.jpg
  Cache-Control: public, max-age=0, must-revalidate
